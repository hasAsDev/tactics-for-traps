# Sao chép thành .env.local khi chạy local. Trên Vercel, đặt các biến này trong Project Settings → Environment Variables.

# Postgres. Local dùng PGlite (npm run db:up). Trên Vercel, Neon tự thêm hai biến này.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
DATABASE_URL_UNPOOLED=postgres://postgres:postgres@127.0.0.1:5432/postgres

# Better Auth. Tạo secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Origin chính thức của site, ví dụ https://tactics-for-traps.vercel.app (redirect OAuth Lichess dựa vào đây)
BETTER_AUTH_URL=http://localhost:3000

# Khoá AES-256-GCM để mã hoá token Lichess (32 byte, base64):
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Vercel Cron gửi "Authorization: Bearer <CRON_SECRET>" (ít nhất 16 ký tự)
CRON_SECRET=

LICHESS_CLIENT_ID=tactics-for-traps
SITE_TIMEZONE=Asia/Ho_Chi_Minh

# Tuỳ chọn, khi bị spam đăng ký:
# SIGNUP_DISABLED=1
# SIGNUP_INVITE_CODE=ma-moi-bi-mat
